# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# On a server, set these from Key Vault rather than a file. Nothing here
# should ever be committed.

# Source: the reporting replica. Never point this at the live instance.
AUS_SOURCE_SERVER=fw04-sqlreporting01.database.windows.net

# Target: the warehouse this project owns.
AUS_WAREHOUSE_SERVER=<your-warehouse>.database.windows.net
AUS_WAREHOUSE_DATABASE=AusReporting

# Use a dedicated service login, not a named person's account. The source
# side needs db_datareader and nothing more.
AUS_SQL_USERNAME=
AUS_SQL_PASSWORD=

# Optional
AUS_ODBC_DRIVER=ODBC Driver 18 for SQL Server
AUS_BATCH_SIZE=50000
AUS_LOGIN_TIMEOUT=30
