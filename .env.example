# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# On a server, set these from Key Vault rather than a file. Nothing here
# should ever be committed.

# ---------------------------------------------------------------------
# Source: the reporting replica. Never point this at the live instance.
# ---------------------------------------------------------------------
AUS_SOURCE_SERVER=fw04-sqlreporting01.database.windows.net

# Read-only login, issued by the Azure admins. Needs db_datareader on
# both Overflow and OverflowReporting, and nothing more.
AUS_SOURCE_USERNAME=
AUS_SOURCE_PASSWORD=

# ---------------------------------------------------------------------
# Warehouse: the database this project owns.
# ---------------------------------------------------------------------
AUS_WAREHOUSE_SERVER=<your-warehouse>.database.windows.net
AUS_WAREHOUSE_DATABASE=AusReporting

# The warehouse login. A separate server means a separate login: leave
# these blank ONLY if the warehouse lives on the same server as the
# source and the same login can write to it.
AUS_WAREHOUSE_USERNAME=
AUS_WAREHOUSE_PASSWORD=

# ---------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------
AUS_ODBC_DRIVER=ODBC Driver 18 for SQL Server
AUS_BATCH_SIZE=50000
AUS_LOGIN_TIMEOUT=30
